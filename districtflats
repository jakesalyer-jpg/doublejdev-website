<style>
:root {
    --ink: #1a1a1a;
    --paper: #f7f4ee;
    --cream: #ede7d9;
    --rust: #b8472d;
    --rust-dark: #8f3520;
    --sage: #4a5d4a;
    --gold: #c9a961;
    --char: #2a2a2a;
    --line: rgba(26, 26, 26, 0.12);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
    font-family: 'Inter', sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.6;
    overflow-x: hidden;
}

/* ===== TYPOGRAPHY ===== */
h1, h2, h3, h4 { font-family: 'Fraunces', serif; font-weight: 400; letter-spacing: -0.02em; }

.serif { font-family: 'Fraunces', serif; }
.italic { font-style: italic; }

/* ===== NAV ===== */
.nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(247, 244, 238, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
}

.nav-logo {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 10px;
}

.nav-diamond {
    width: 14px;
    height: 14px;
    background: var(--ink);
    transform: rotate(45deg);
}

.nav-cta {
    padding: 10px 22px;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    border: 1px solid var(--ink);
}

.nav-cta:hover {
    background: transparent;
    color: var(--ink);
}

/* ===== HERO ===== */
.hero {
    min-height: 100vh;
    padding: 140px 40px 80px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
    background:
        radial-gradient(ellipse at top right, rgba(184, 71, 45, 0.08), transparent 50%),
        radial-gradient(ellipse at bottom left, rgba(74, 93, 74, 0.06), transparent 50%),
        var(--paper);
}

.hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image:
        repeating-linear-gradient(0deg, transparent, transparent 80px, rgba(26,26,26,0.02) 80px, rgba(26,26,26,0.02) 81px);
    pointer-events: none;
}

.hero-content { position: relative; z-index: 2; }

.hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 32px;
    animation: fadeUp 0.8s ease-out;
}

.hero-eyebrow::before {
    content: '';
    width: 32px;
    height: 1px;
    background: var(--rust);
}

.hero h1 {
    font-size: clamp(3rem, 6.5vw, 5.5rem);
    line-height: 0.98;
    margin-bottom: 36px;
    animation: fadeUp 0.9s ease-out 0.1s backwards;
}

.hero h1 .accent {
    font-style: italic;
    font-weight: 300;
    color: var(--rust);
}

.hero-sub {
    font-size: 19px;
    line-height: 1.5;
    color: var(--char);
    max-width: 480px;
    margin-bottom: 48px;
    animation: fadeUp 1s ease-out 0.2s backwards;
}

.hero-stats {
    display: flex;
    gap: 48px;
    margin-bottom: 56px;
    animation: fadeUp 1.1s ease-out 0.3s backwards;
}

.stat-num {
    font-family: 'Fraunces', serif;
    font-size: 42px;
    font-weight: 400;
    line-height: 1;
    margin-bottom: 6px;
    display: block;
}

.stat-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--char);
    opacity: 0.6;
}

.hero-buttons {
    display: flex;
    gap: 16px;
    animation: fadeUp 1.2s ease-out 0.4s backwards;
}

.btn-primary {
    padding: 16px 32px;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--ink);
}

.btn-primary:hover {
    background: var(--rust);
    border-color: var(--rust);
    transform: translateY(-2px);
}

.btn-secondary {
    padding: 16px 32px;
    background: transparent;
    color: var(--ink);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    border: 1px solid var(--ink);
}

.btn-secondary:hover {
    background: var(--ink);
    color: var(--paper);
}

/* ===== HERO IMAGE/MOCKUP ===== */
.hero-visual {
    position: relative;
    height: 600px;
    animation: fadeUp 1.2s ease-out 0.3s backwards;
}

.hero-mockup {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--cream) 0%, #d4c9a8 100%);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.15);
}

.hero-mockup-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}

.hero-floating-card {
    position: absolute;
    padding: 24px 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
    z-index: 3;
}

.hero-floating-card.tl {
    top: 30px;
    left: -30px;
    animation: floatY 6s ease-in-out infinite;
}

.hero-floating-card.br {
    bottom: 40px;
    right: -20px;
    animation: floatY 6s ease-in-out infinite reverse;
}

.hero-card-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--char);
    opacity: 0.6;
    margin-bottom: 4px;
}

.hero-card-value {
    font-family: 'Fraunces', serif;
    font-size: 26px;
    font-weight: 500;
}

.hero-card-value .small {
    font-size: 14px;
    opacity: 0.6;
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
}

/* ===== SECTIONS ===== */
section { padding: 120px 40px; position: relative; }

.section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 24px;
}

.section-eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--rust);
}

.section-title {
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    line-height: 1.05;
    max-width: 800px;
    margin-bottom: 24px;
}

.section-title .accent { font-style: italic; color: var(--rust); font-weight: 300; }

.section-lead {
    font-size: 18px;
    line-height: 1.6;
    max-width: 680px;
    color: var(--char);
    margin-bottom: 80px;
}

/* ===== HIGHLIGHT BAR ===== */
.highlight-bar {
    background: var(--ink);
    color: var(--paper);
    padding: 60px 40px;
    text-align: center;
    overflow: hidden;
    position: relative;
}

.highlight-bar h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.15;
    max-width: 900px;
    margin: 0 auto;
    font-weight: 400;
}

.highlight-bar .accent {
    color: var(--gold);
    font-style: italic;
}

.highlight-bar-sub {
    margin-top: 16px;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
}

/* ===== FEATURES GRID ===== */
.features {
    background: var(--paper);
}

.features-container { max-width: 1300px; margin: 0 auto; }

.features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
}

.feature {
    padding: 48px 40px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background 0.3s ease;
}

.feature:hover {
    background: var(--cream);
}

.feature-icon {
    width: 36px;
    height: 36px;
    margin-bottom: 24px;
    color: var(--rust);
}

.feature h3 {
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 12px;
}

.feature p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--char);
    opacity: 0.8;
}

/* ===== SPECS SECTION ===== */
.specs {
    background: var(--cream);
    padding: 120px 40px;
}

.specs-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
}

.specs-list {
    list-style: none;
}

.specs-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
}

.specs-list li:last-child { border-bottom: none; }

.spec-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--char);
    opacity: 0.7;
}

.spec-value {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 500;
    text-align: right;
}

.spec-value .small {
    font-size: 14px;
    font-weight: 400;
    opacity: 0.7;
}

/* ===== LOCATION ===== */
.location {
    background: var(--paper);
    padding: 120px 40px;
}

.location-container {
    max-width: 1200px;
    margin: 0 auto;
}

.location-header {
    text-align: center;
    margin-bottom: 80px;
}

.location-header .section-eyebrow,
.cta-section .section-eyebrow {
    justify-content: center;
}

.location-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
}

.location-card {
    padding: 36px 28px;
    background: var(--cream);
    border: 1px solid var(--line);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.location-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
}

.location-card-distance {
    font-family: 'Fraunces', serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
    margin-bottom: 4px;
    color: var(--rust);
}

.location-card-unit {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--char);
    opacity: 0.6;
    margin-bottom: 20px;
}

.location-card-name {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 6px;
}

.location-card-desc {
    font-size: 13px;
    color: var(--char);
    opacity: 0.7;
}

/* ===== CTA / FORM SECTION ===== */
.cta-section {
    padding: 120px 40px;
    background:
        radial-gradient(ellipse at top, rgba(184, 71, 45, 0.06), transparent 60%),
        var(--paper);
    position: relative;
}

.cta-container {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
}

.cta-container .section-title { margin: 0 auto 24px; }
.cta-container .section-lead { margin: 0 auto 56px; }

.lead-form {
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 48px;
    text-align: left;
    box-shadow: 12px 12px 0 var(--ink);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.form-field {
    display: flex;
    flex-direction: column;
}

.form-field.full { grid-column: 1 / -1; }

.form-field label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 8px;
    color: var(--char);
}

.form-field input,
.form-field select {
    padding: 14px 16px;
    background: transparent;
    border: 1px solid var(--line);
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: var(--ink);
    transition: border-color 0.2s ease;
}

.form-field input:focus,
.form-field select:focus {
    outline: none;
    border-color: var(--ink);
}

.form-submit {
    width: 100%;
    padding: 18px;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 12px;
}

.form-submit:hover:not(:disabled) {
    background: var(--rust);
    border-color: var(--rust);
}

.form-submit:disabled {
    opacity: 0.5;
    cursor: wait;
}

.form-disclaimer {
    font-size: 11px;
    color: var(--char);
    opacity: 0.6;
    margin-top: 16px;
    line-height: 1.5;
}

.form-success {
    display: none;
    text-align: center;
    padding: 60px 40px;
}

.form-success.active { display: block; }

.form-success h3 {
    font-size: 36px;
    margin-bottom: 16px;
}

.form-success p {
    font-size: 17px;
    color: var(--char);
}

/* ===== FOOTER ===== */
footer {
    background: var(--ink);
    color: var(--paper);
    padding: 60px 40px 40px;
}

.footer-container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 32px;
}

.footer-logo {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
}

.footer-logo-diamond {
    width: 12px;
    height: 12px;
    background: var(--paper);
    transform: rotate(45deg);
}

.footer-meta {
    font-size: 12px;
    opacity: 0.6;
    letter-spacing: 0.05em;
}

.footer-eho {
    font-size: 11px;
    opacity: 0.5;
    margin-top: 8px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 968px) {
    .nav { padding: 16px 24px; }
    .hero {
        padding: 120px 24px 60px;
        grid-template-columns: 1fr;
        gap: 60px;
    }
    .hero h1 { font-size: clamp(2.4rem, 9vw, 3.5rem); }
    .hero-stats { gap: 32px; }
    .stat-num { font-size: 32px; }
    .hero-visual { height: 400px; }
    .hero-floating-card { padding: 16px 20px; }
    .hero-floating-card.tl { left: 10px; }
    .hero-floating-card.br { right: 10px; }
    section { padding: 80px 24px; }
    .specs, .location, .cta-section { padding: 80px 24px; }
    .features-grid { grid-template-columns: 1fr; }
    .feature { padding: 36px 28px; }
    .specs-container { grid-template-columns: 1fr; gap: 40px; }
    .location-grid { grid-template-columns: repeat(2, 1fr); }
    .form-row { grid-template-columns: 1fr; }
    .lead-form { padding: 28px; box-shadow: 6px 6px 0 var(--ink); }
    .footer-container { flex-direction: column; text-align: center; }
}

@media (max-width: 480px) {
    .hero-buttons { flex-direction: column; }
    .btn-primary, .btn-secondary { width: 100%; justify-content: center; text-align: center; }
    .location-grid { grid-template-columns: 1fr; }
    .hero-floating-card { padding: 14px 16px; }
    .hero-card-value { font-size: 20px; }
}
</style>
</head>
