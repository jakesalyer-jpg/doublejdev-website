    </div>

    <div class="hero-visual">
        <div class="hero-floating-card tl">
            <div class="hero-card-label">Available</div>
            <div class="hero-card-value">6 Units</div>
        </div>

        <div class="hero-mockup">
            <svg class="hero-mockup-svg" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <linearGradient id="sky" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#e8dcc0"/>
                        <stop offset="100%" stop-color="#d4c9a8"/>
                    </linearGradient>
                    <linearGradient id="building" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#3a3a3a"/>
                        <stop offset="100%" stop-color="#2a2a2a"/>
                    </linearGradient>
                    <linearGradient id="window" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#f4ead4"/>
                        <stop offset="100%" stop-color="#d4b878"/>
                    </linearGradient>
                </defs>

                <!-- Sky -->
                <rect width="600" height="600" fill="url(#sky)"/>

                <!-- Sun glow -->
                <circle cx="480" cy="140" r="60" fill="#f4d4a0" opacity="0.5"/>
                <circle cx="480" cy="140" r="30" fill="#f4d4a0" opacity="0.7"/>

                <!-- Distant skyline -->
                <rect x="0" y="380" width="80" height="80" fill="#a59478" opacity="0.4"/>
                <rect x="80" y="360" width="100" height="100" fill="#a59478" opacity="0.4"/>
                <rect x="540" y="370" width="60" height="90" fill="#a59478" opacity="0.4"/>

                <!-- Ground -->
                <rect x="0" y="460" width="600" height="140" fill="#8a7a5a"/>

                <!-- Main building (sixplex - 3 visible units) -->
                <rect x="80" y="200" width="440" height="280" fill="url(#building)"/>

                <!-- Roof line -->
                <rect x="75" y="195" width="450" height="10" fill="#1a1a1a"/>

                <!-- Unit dividers -->
                <line x1="226" y1="200" x2="226" y2="480" stroke="#1a1a1a" stroke-width="2"/>
                <line x1="372" y1="200" x2="372" y2="480" stroke="#1a1a1a" stroke-width="2"/>

                <!-- Unit 1 windows -->
                <rect x="100" y="230" width="50" height="70" fill="url(#window)"/>
                <rect x="160" y="230" width="50" height="70" fill="url(#window)"/>
