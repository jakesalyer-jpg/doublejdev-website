<script>
// ============================================
// FORM HANDLING
// ============================================
const form = document.getElementById('leadForm');
const successMsg = document.getElementById('formSuccess');
const submitBtn = document.getElementById('submitBtn');

form.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    const formData = {
        firstName: document.getElementById('firstName').value,
        lastName: document.getElementById('lastName').value,
        email: document.getElementById('email').value,
        phone: document.getElementById('phone').value,
        moveIn: document.getElementById('moveIn').value,
        occupants: document.getElementById('occupants').value,
        timestamp: new Date().toISOString(),
        source: 'District Flats Landing'
    };

    // ============================================
    // FIRE META PIXEL "LEAD" EVENT
    // ============================================
    if (typeof fbq !== 'undefined') {
        fbq('track', 'Lead', {
            content_name: 'District Flats Tour Request',
            content_category: 'Housing',
            value: 2200.00,
            currency: 'USD'
        });
    }

    // ============================================
    // SEND LEAD TO YOUR ENDPOINT
    // ============================================
    // Replace '/api/lead' with your actual endpoint.
    // Options:
    //   1. Vercel serverless function at /api/lead.js
    //   2. Formspree: https://formspree.io/f/YOUR_FORM_ID
    //   3. Netlify Forms / EmailJS / Zapier webhook
    //
    // For now this will gracefully fall through if the endpoint
    // doesn't exist yet — the lead still fires to Pixel.

    try {
        await fetch('/api/lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });
    } catch (err) {
        console.log('Lead endpoint not configured yet - lead captured by Pixel only');
    }

    // Always show success (don't block UX on backend errors)
    setTimeout(() => {
        form.style.display = 'none';
        successMsg.classList.add('active');
    }, 600);
});

// ============================================
// SMOOTH SCROLL FOR NAV LINKS
// ============================================
document.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('href');
        if (targetId === '#') return;
        const target = document.querySelector(targetId);
        if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
});
</script>

